<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Paper" Color="#F2F5F5"/>
    <SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Ink" Color="#172C39"/>
    <SolidColorBrush x:Key="Quiet" Color="#526774"/>
    <SolidColorBrush x:Key="Rule" Color="#D4DFE2"/>
    <SolidColorBrush x:Key="Soft" Color="#EAF1F1"/>
    <SolidColorBrush x:Key="Ready" Color="#1C654C"/>
    <SolidColorBrush x:Key="ReadySurface" Color="#E0F1E7"/>
    <SolidColorBrush x:Key="Warning" Color="#9A3E27"/>
    <SolidColorBrush x:Key="WarningSurface" Color="#FBEAE4"/>
    <SolidColorBrush x:Key="Focus" Color="#166275"/>
    <SolidColorBrush x:Key="StageInk" Color="#F0F6F2"/>
    <SolidColorBrush x:Key="StageFocus" Color="#FFCF83"/>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="MinHeight" Value="31"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="8,3"/>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="Action" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        <Setter Property="Background" Value="{StaticResource Card}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Rule}"/>
        <Setter Property="Padding" Value="11,7"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Frame" Padding="{TemplateBinding Padding}" CornerRadius="6"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{StaticResource Soft}"/>
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Focus}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Frame" Property="Opacity" Value="0.76"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Focus}"/>
                            <Setter TargetName="Frame" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Frame" Property="Opacity" Value="0.47"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Mode" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Quiet}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Frame" CornerRadius="5" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="1" Padding="13,6">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{StaticResource Soft}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Frame" Property="Background" Value="{StaticResource Card}"/>
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Rule}"/>
                            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource Focus}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BoardButton" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Hit" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="1" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Hit" Property="BorderBrush" Value="{StaticResource StageFocus}"/>
                            <Setter TargetName="Hit" Property="Background" Value="#50FFCF83"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hit" Property="BorderBrush" Value="{StaticResource StageFocus}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Hit" Property="BorderBrush" Value="{StaticResource StageFocus}"/>
                            <Setter TargetName="Hit" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Contact" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Hit" Background="Transparent" BorderBrush="Transparent"
                            BorderThickness="1" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="connected">
                            <Setter TargetName="Hit" Property="BorderBrush" Value="#6BB6D7CB"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="selected">
                            <Setter TargetName="Hit" Property="BorderBrush" Value="{StaticResource StageFocus}"/>
                            <Setter TargetName="Hit" Property="Background" Value="#44FFCF83"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hit" Property="BorderBrush" Value="{StaticResource StageFocus}"/>
                            <Setter TargetName="Hit" Property="Background" Value="#32FFF2CE"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hit" Property="Background" Value="#65FFCF83"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="electrical">
                            <Setter TargetName="Hit" Property="BorderBrush" Value="{StaticResource Warning}"/>
                            <Setter TargetName="Hit" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="Hit" Property="Background" Value="#4DFF927C"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Hit" Property="BorderBrush" Value="{StaticResource StageFocus}"/>
                            <Setter TargetName="Hit" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
